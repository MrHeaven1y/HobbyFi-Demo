# Environment
APP_NAME="HobbyFi Copilot"
APP_ENV="development"
DEBUG=True

# Database (PostgreSQL + pgvector in Docker)
DATABASE_URL="postgresql://neondb_owner:npg_I2MsptqB0ALR@ep-shiny-king-aidcs00r.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require"

# LLM (Google Gemini - Free Tier)
GEMINI_API_KEY="your-gemini-api-key-here"

# Model Configuration
LLM_MODEL_NAME="gemini-2.5-flash"

# Demo fallback controls
# Free-tier LLM calls are quota-limited. After this many calls per app process,
# the demo switches to deterministic local CRM responses.
ENABLE_LOCAL_DEMO_FALLBACK=True
DEMO_LLM_CALL_BUDGET=6

# Optional local model fallback. If Ollama is running and the model exists,
# the app uses it after Gemini quota is exhausted. Otherwise it uses the
# deterministic audited demo responder.
LOCAL_MODEL_ENABLED=True
LOCAL_MODEL_BASE_URL="http://127.0.0.1:11434"
LOCAL_MODEL_NAME="llama3.2"
LOCAL_MODEL_TIMEOUT_SECONDS=5
